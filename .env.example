# Variable names only. Copy to `.env` (git-ignored) and fill values locally.
# Never commit a real value: this repository is public and CI runs gitleaks on every PR.
# Hosted environments get values from their secret stores (Fly.io secrets, Vercel env, GitHub).

# --- Control-plane API (backend/, read today by harness.config.Settings) ---
HARNESS_ENVIRONMENT=
HARNESS_LOG_LEVEL=
# JSON list, for example ["http://localhost:3000"]
HARNESS_CORS_ORIGINS=

# --- Request auth: Supabase Auth access tokens (backend/src/harness/auth, docs/auth.md) ---
# Auth is off until both are set; tenant routes then return 503. Not secrets (public endpoints).
# Hosted: https://<project-ref>.supabase.co/auth/v1 and <that>/.well-known/jwks.json
HARNESS_AUTH_ISSUER=
HARNESS_AUTH_JWKS_URL=
# Optional. Defaults: authenticated, ["ES256","RS256"], 10, 600, 30. HS256 and none are refused.
HARNESS_AUTH_AUDIENCE=
HARNESS_AUTH_ALGORITHMS=
HARNESS_AUTH_LEEWAY_SECONDS=
HARNESS_AUTH_JWKS_CACHE_SECONDS=
HARNESS_AUTH_JWKS_MIN_REFETCH_SECONDS=

# --- Supabase: Postgres, Auth, Storage (planned M1) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
SUPABASE_JWT_ISSUER=

# --- Model providers (planned M1; per-hotel keys live in the tenant secret store, not here) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- LLM tracing for all runtimes: Langfuse, cloud or self-hosted (planned M1) ---
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- opencode runtime adapter (planned M3) ---
OPENCODE_SERVER_URL=
OPENCODE_SERVER_USERNAME=
OPENCODE_SERVER_PASSWORD=

# --- Sandboxes (planned M2) ---
# One of: fly_machines, docker_local
SANDBOX_PROVIDER=
FLY_API_TOKEN=
FLY_SANDBOX_APP=

# --- GitHub App used to branch, push and open PRs on hotel agent repos (planned M2) ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=

# --- Eval gate: separate service, the only holder of a merge credential (planned M2) ---
# EVAL_GATE_API_TOKEN is set on both the API and the eval gate.
EVAL_GATE_GITHUB_APP_ID=
EVAL_GATE_GITHUB_APP_PRIVATE_KEY=
EVAL_GATE_DB_URL=
EVAL_GATE_API_TOKEN=

# --- Connectors (planned M3) ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- InsForge: hosts product-agent backends only; the harness reads deploy status (see docs/architecture.md, D8) ---
INSFORGE_BASE_URL=
INSFORGE_API_KEY=

# --- Tenant secret envelope encryption (planned M1) ---
HARNESS_KMS_KEY_ID=

# --- Web UI (web/; NEXT_PUBLIC_* values reach the browser, so they must not be secrets) ---
NEXT_PUBLIC_HARNESS_API_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
